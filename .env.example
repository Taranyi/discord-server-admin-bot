# Create a Discord application and place its bot token here.
DISCORD_TOKEN=your_bot_token_here

# Use a test server ID while developing. Required when command sync is "guild".
DISCORD_GUILD_ID=your_test_server_id_here

# Allowed values: off, guild, global
# "guild" updates commands quickly in the configured test server.
DISCORD_COMMAND_SYNC=guild

# Standard Python logging level, for example DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# Optional local paths. These defaults are normally sufficient.
DISCORD_CONFIG_PATH=config.yaml
DISCORD_DATABASE_PATH=data/bot.db
